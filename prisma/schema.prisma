// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  currency  String   @default("NGN")
  timezone  String   @default("Africa/Lagos")
  createdAt DateTime @default(now())
  branches  Branch[]
  memberships Membership[]
  products  Product[]
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  branchStock    BranchStock[]
  stockMovements StockMovement[]
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  createdAt    DateTime @default(now())
  memberships  Membership[]
  refreshTokens RefreshToken[]
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String?
  roleId         String
  role           Role     @relation(fields: [roleId], references: [id])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
  memberships Membership[]
}

model Product {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  sku            String?
  barcode        String?
  unit           String?  // e.g. "piece", "kg", "pack"
  price          Int      // integer minor units (org currency). Never a float.
  cost           Int      // integer minor units. Never a float.
  active         Boolean  @default(true)
  version        Int      @default(0) // incremented on every edit; used by sync conflict handling
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, active])
  branchStock    BranchStock[]
  stockMovements StockMovement[]
}

enum StockMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
}

// Cached per-branch quantity. Updated in the same transaction as the ledger and
// rebuildable from stock_movement at any time. Only the inventory module writes it.
model BranchStock {
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  qty               Int      @default(0)
  lowStockThreshold Int      @default(0)
  flags             String[] @default([]) // e.g. ["NEGATIVE_STOCK"]
  updatedAt         DateTime @updatedAt

  @@id([branchId, productId])
  @@index([branchId])
}

// Immutable ledger. Every stock change is one row; current qty is the sum.
model StockMovement {
  id        String            @id @default(uuid())
  branchId  String
  branch    Branch            @relation(fields: [branchId], references: [id])
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  type      StockMovementType
  qtyDelta  Int               // signed: negative for SALE, positive for RESTOCK
  refType   String?           // originating entity, e.g. "sale", "adjustment"
  refId     String?
  reason    String?           // required for manual adjustments
  createdBy String?
  createdAt DateTime          @default(now())

  @@index([branchId, productId, createdAt])
}

// Append-only. Written in the same transaction as the action it records.
// No foreign keys so a retention/rotation policy can prune actors without losing history.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String?
  action         String   // e.g. "product.price_changed"
  entity         String   // e.g. "Product"
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  revokedAt DateTime?
  replacedBy String?
}