// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                    String                 @id @default(uuid())
  name                  String
  currency              String                 @default("NGN")
  timezone              String                 @default("Africa/Lagos")
  createdAt             DateTime               @default(now())
  branches              Branch[]
  memberships           Membership[]
  products              Product[]
  paymentAccounts       PaymentAccount[]
  payments              Payment[]
  sales                 Sale[]
  managedPaymentAccount ManagedPaymentAccount?
  payoutAccount         PayoutAccount?
}

model Branch {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  branchStock    BranchStock[]
  stockMovements StockMovement[]
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?
  passwordHash  String
  emailVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  refreshTokens RefreshToken[]
  pushSubscriptions PushSubscription[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

// A Web Push endpoint for one browser/device of one user. The push service URL
// (endpoint) is globally unique; the p256dh/auth keys encrypt the payload so
// only that browser can read it. Pruned when the push service reports it gone.
model PushSubscription {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  organizationId String
  endpoint       String   @unique
  p256dh         String
  auth           String
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String?
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  permissions String[]
  memberships Membership[]
}

model Product {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  sku            String?
  barcode        String?
  unit           String? // e.g. "piece", "kg", "pack"
  price          Int // integer minor units (org currency). Never a float.
  cost           Int // integer minor units. Never a float.
  active         Boolean         @default(true)
  version        Int             @default(0) // incremented on every edit; used by sync conflict handling
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branchStock    BranchStock[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, active])
}

enum StockMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
}

// Cached per-branch quantity. Updated in the same transaction as the ledger and
// rebuildable from stock_movement at any time. Only the inventory module writes it.
model BranchStock {
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  qty               Int      @default(0)
  lowStockThreshold Int      @default(0)
  flags             String[] @default([]) // e.g. ["NEGATIVE_STOCK"]
  updatedAt         DateTime @updatedAt

  @@id([branchId, productId])
  @@index([branchId])
}

// Immutable ledger. Every stock change is one row; current qty is the sum.
model StockMovement {
  id        String            @id @default(uuid())
  branchId  String
  branch    Branch            @relation(fields: [branchId], references: [id])
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  type      StockMovementType
  qtyDelta  Int // signed: negative for SALE, positive for RESTOCK
  refType   String? // originating entity, e.g. "sale", "adjustment"
  refId     String?
  reason    String? // required for manual adjustments
  createdBy String?
  createdAt DateTime          @default(now())

  @@index([branchId, productId, createdAt])
}

// Append-only. Written in the same transaction as the action it records.
// No foreign keys so a retention/rotation policy can prune actors without losing history.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String?
  action         String // e.g. "product.price_changed"
  entity         String // e.g. "Product"
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  usedAt     DateTime?
  revokedAt  DateTime?
  replacedBy String?
}

// Single-use, short-lived token for confirming a user's email address. Only the
// SHA-256 hash is stored (never the raw token), the same way refresh tokens are
// kept; the raw token lives only in the verification link we email.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Single-use, short-lived token for resetting a forgotten password. Only the
// SHA-256 hash is stored; the raw token lives only in the emailed reset link.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A merchant-declared bank account that settlements/withdrawals are paid out to.
// One per organization. The full account number is encrypted at rest (AES-256-GCM,
// like payment secrets); only the last four digits are kept in the clear for
// display. This records where money should go — it does not move money itself.
model PayoutAccount {
  id                      String       @id @default(uuid())
  organizationId          String       @unique
  organization            Organization @relation(fields: [organizationId], references: [id])
  bankCode                String
  bankName                String
  accountName             String
  accountNumberCiphertext String
  accountNumberLast4      String
  currency                String       @default("NGN")
  createdBy               String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

// Transactional outbox. A domain event is written here in the SAME transaction
// as the data change, then a worker publishes it to the queue and marks it
// processed. Guarantees at-least-once delivery without distributed transactions.
model OutboxEvent {
  id          String    @id @default(uuid())
  type        String // e.g. "payment.received", "sale.created", "stock.low"
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  organizationId String? // optional: for multi-tenant filtering
  attempts       Int       @default(0)
  lastError      String?
  availableAt    DateTime  @default(now())
  lockToken      String?
  lockedUntil    DateTime?

  @@index([processedAt, createdAt])
  @@index([processedAt, availableAt, lockedUntil])
}

enum PaymentProvider {
  PAYSTACK
}

enum PaymentAccountStatus {
  ACTIVE
  DISABLED
}

enum ManagedPaymentAccountStatus {
  PENDING
  ACTIVE
  DISABLED
  FAILED
}

enum DedicatedVirtualAccountStatus {
  PENDING
  ACTIVE
  DISABLED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  QUARANTINED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  // REFUNDED / CHARGEBACK: add later as separate refund records, not a status flag
}

model PaymentAccount {
  id                   String               @id @default(uuid())
  organizationId       String
  organization         Organization         @relation(fields: [organizationId], references: [id])
  branchId             String?
  provider             PaymentProvider
  providerAccountId    String? // optional: may not be known until first real event
  status               PaymentAccountStatus @default(ACTIVE)
  integrationTokenHash String               @unique
  secretCiphertext     String
  keyVersion           Int                  @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookEvents WebhookEvent[]
  payments      Payment[]

  // One provider account can belong to only one tenant (NULLs are exempt).
  @@unique([provider, providerAccountId])
  @@index([organizationId, provider, status])
}

model ManagedPaymentAccount {
  id                          String                      @id @default(uuid())
  organizationId              String                      @unique
  organization                Organization                @relation(fields: [organizationId], references: [id])
  provider                    PaymentProvider
  status                      ManagedPaymentAccountStatus @default(PENDING)
  providerSubaccountCode      String?                     @unique
  providerCustomerCode        String?                     @unique
  settlementBankCode          String?
  settlementBankName          String?
  settlementAccountName       String?
  settlementAccountLast4      String?
  settlementAccountCiphertext String?
  percentageCharge            Decimal                     @default(0) @db.Decimal(5, 2)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  virtualAccounts DedicatedVirtualAccount[]
  payments        Payment[]

  @@index([provider, status])
}

model DedicatedVirtualAccount {
  id                      String                        @id @default(uuid())
  managedPaymentAccountId String
  managedPaymentAccount   ManagedPaymentAccount         @relation(fields: [managedPaymentAccountId], references: [id])
  provider                PaymentProvider
  providerAccountId       String?                       @unique
  providerCustomerCode    String                        @unique
  accountName             String
  accountNumber           String                        @unique
  bankName                String
  bankSlug                String?
  currency                String                        @default("NGN")
  status                  DedicatedVirtualAccountStatus @default(PENDING)
  assignedAt              DateTime?
  disabledAt              DateTime?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  payments Payment[]

  @@index([managedPaymentAccountId, status])
}

model WebhookEvent {
  id                String             @id @default(uuid())
  paymentAccountId  String?
  paymentAccount    PaymentAccount?    @relation(fields: [paymentAccountId], references: [id])
  eventType         String // raw provider string, e.g. "charge.success"
  payload           Json? // parsed body, only for valid JSON + valid signature
  rawBody           String // exact bytes received (truncated if oversized + unauthenticated)
  signatureValid    Boolean            @default(false)
  dedupeKey         String
  platformDedupeKey String?            @unique
  status            WebhookEventStatus @default(RECEIVED)
  attempts          Int                @default(0)
  lastError         String?
  correlationId     String
  receivedAt        DateTime           @default(now())
  processedAt       DateTime?
  claimedAt         DateTime?
  availableAt       DateTime           @default(now())

  // Idempotency layer 1. Quarantined rows (null account) are not deduped: acceptable.
  @@unique([paymentAccountId, dedupeKey])
  // Worker query: oldest unprocessed events across all accounts.
  @@index([status, receivedAt])
  @@index([paymentAccountId, receivedAt])
}

model Payment {
  id                        String                   @id @default(uuid())
  paymentAccountId          String?
  paymentAccount            PaymentAccount?          @relation(fields: [paymentAccountId], references: [id])
  managedPaymentAccountId   String?
  managedPaymentAccount     ManagedPaymentAccount?   @relation(fields: [managedPaymentAccountId], references: [id])
  dedicatedVirtualAccountId String?
  dedicatedVirtualAccount   DedicatedVirtualAccount? @relation(fields: [dedicatedVirtualAccountId], references: [id])
  organizationId            String
  organization              Organization             @relation(fields: [organizationId], references: [id])
  branchId                  String? // copied from the account at write time
  providerReference         String
  providerPaymentId         String? // informational only, NOT part of any unique
  amountMinor               BigInt // kobo; convert to string/number at the API boundary
  currency                  String
  method                    String
  status                    PaymentStatus            @default(PENDING)
  occurredAt                DateTime
  receivedAt                DateTime                 @default(now())
  allocation                SaleAllocation?

  // Postgres permits multiple NULL values, so separate keys cover each flow.
  @@unique([paymentAccountId, providerReference])
  @@unique([managedPaymentAccountId, providerReference])
  @@index([organizationId, status, occurredAt])
  @@index([organizationId, branchId, status, occurredAt])
  @@index([dedicatedVirtualAccountId, occurredAt])
}

// A confirmed payment turned into a recorded sale. Allocation is tracked here, 
// separate from Payment.status (see docs/payments-contract.md).
model Sale {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  branchId       String?
  total          BigInt // sum(unitPrice * qty), integer minor units
  margin         BigInt // sum((unitPrice - unitCost) * qty)
  variance       BigInt           @default(0) // paymentAmount - total (signed); 0 when exact
  flagged        Boolean          @default(false) // variance beyond SALE_VARIANCE_TOLERANCE
  idempotencyKey String? // client-supplied; replay returns the same sale
  createdBy      String?
  createdAt      DateTime         @default(now())
  items          SaleItem[]
  allocations    SaleAllocation[]
  refunds        Refund[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
}

// A full or partial reversal of a sale: restores stock (RETURN movements) and
// reverses revenue/margin. The money-back at the provider is tracked, not run.
model Refund {
  id             String       @id @default(uuid())
  saleId         String
  sale           Sale         @relation(fields: [saleId], references: [id])
  organizationId String
  branchId       String?
  amountMinor    BigInt // total refunded, integer minor units
  marginReversed BigInt // margin reversed
  reason         String?
  createdBy      String?
  createdAt      DateTime     @default(now())
  items          RefundItem[]

  @@index([organizationId, createdAt])
  @@index([saleId])
}

model RefundItem {
  id        String @id @default(uuid())
  refundId  String
  refund    Refund @relation(fields: [refundId], references: [id])
  productId String
  qty       Int
  unitPrice Int // snapshot carried from the sale item
  unitCost  Int

  @@index([refundId])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Int // snapshot at sale time; never recomputed from current price
  unitCost  Int // snapshot at sale time

  @@index([saleId])
}

// One sale per payment: the unique paymentId is the atomic double-tap guard.
// No relation to Payment (owned by payments); the service validates existence.
model SaleAllocation {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount    BigInt

  @@index([saleId])
}

// Every notification send attempt, across channels. For audit + delivery tracking.
model NotificationLog {
  id                String   @id @default(uuid())
  organizationId    String
  userId            String?
  eventId           String? // source outbox event id, for dedup on redelivery
  channel           String // "whatsapp" | "email" | "simulated"
  template          String // named template, e.g. "payment.received"
  recipient         String // phone or email (redact PII in logs, not here)
  status            String // "SENT" | "FAILED"
  providerMessageId String?
  error             String?
  createdAt         DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([eventId])
}
