  "info": {
    "title": "Invent-IO API",
    "description": "Payment-triggered inventory backend",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Bar Soap"
          },
          "sku": {
            "type": "string",
            "example": "SOAP-001"
          },
          "barcode": {
            "type": "string",
            "example": "5901234123457"
          },
          "unit": {
            "type": "string",
            "example": "piece",
            "description": "Unit of sale, e.g. \"piece\", \"kg\""
          },
          "price": {
            "type": "number",
            "example": 150000,
            "description": "Price in integer minor units (e.g. kobo), in the org currency. Never a float."
          },
          "cost": {
            "type": "number",
            "example": 90000,
            "description": "Cost in integer minor units. Never a float."
          }
        },
        "required": [
          "name",
          "price",
          "cost"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Bar Soap"
          },
          "sku": {
            "type": "string",
            "example": "SOAP-001"
          },
          "barcode": {
            "type": "string",
            "example": "5901234123457"
          },
          "unit": {
            "type": "string",
            "example": "piece"
          },
          "price": {
            "type": "number",
            "example": 150000,
            "description": "Price in integer minor units. Never a float."
          },
          "cost": {
            "type": "number",
            "example": 90000,
            "description": "Cost in integer minor units. Never a float."
          },
          "active": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "AdjustStockDto": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "RESTOCK",
              "ADJUSTMENT",
              "RETURN"
            ]
          },
          "qtyDelta": {
            "type": "number",
            "example": 10,
            "description": "Signed change in units (negative to decrease)."
          },
          "reason": {
            "type": "string",
            "example": "Received supplier delivery",
            "description": "Required reason for the adjustment."
          }
        },
        "required": [
          "branchId",
          "productId",
          "type",
          "qtyDelta",
          "reason"
        ]
      },
      "SetThresholdDto": {
        "type": "object",
        "properties": {
          "lowStockThreshold": {
            "type": "number",
            "example": 5,
            "description": "Alert when stock is at or below this (0 disables)."
          }
        },
        "required": [
          "lowStockThreshold"
        ]
      },
      "CreateManagedPaymentAccountDto": {
        "type": "object",
        "properties": {
          "businessName": {
            "type": "string",
            "example": "Example Business Ltd"
          },
          "settlementBankCode": {
            "type": "string",
            "example": "058",
            "description": "Paystack settlement-bank code"
          },
          "settlementAccountNumber": {
            "type": "string",
            "example": "0123456789"
          },
          "ownerEmail": {
            "type": "string",
            "example": "owner@example.com"
          },
          "ownerName": {
            "type": "string",
            "example": "Ada Owner"
          },
          "customerFirstName": {
            "type": "string",
            "example": "Ada"
          },
          "customerLastName": {
            "type": "string",
            "example": "Owner"
          },
          "ownerPhone": {
            "type": "string",
            "example": "+2348012345678"
          },
          "preferredBank": {
            "type": "string",
            "example": "wema-bank"
          },
          "ownerConsent": {
            "type": "boolean",
            "description": "Confirms the organization is authorized to submit these details to Paystack.",
            "example": true
          }
        },
        "required": [
          "businessName",
          "settlementBankCode",
          "settlementAccountNumber",
          "ownerEmail",
          "ownerName",
          "customerFirstName",
          "customerLastName",
          "ownerConsent"
        ]
      },
      "CreateManualPaymentDto": {
        "type": "object",
        "properties": {
          "amountMinor": {
            "type": "string",
            "description": "Amount received in minor currency units (kobo), as a positive integer string.",
            "example": "125000"
          },
          "branchId": {
            "type": "string",
            "description": "Branch that received the cash; defaults to the tenant branch."
          }
        },
        "required": [
          "amountMinor"
        ]
      },
      "SaleItemInput": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "qty": {
            "type": "number",
            "example": 2
          }
        },
        "required": [
          "productId",
          "qty"
        ]
      },
      "AllocatePaymentDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaleItemInput"
            }
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Client-generated; replaying returns the original sale."
          }
        },
        "required": [
          "items",
          "idempotencyKey"
        ]
      },
      "SendNotificationDto": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "whatsapp",
              "email",
              "simulated"
            ]
          },
          "to": {
            "type": "string",
            "description": "Phone number (whatsapp) or email address (email)."
          },
          "template": {
            "type": "string",
            "example": "payment.received"
          },
          "data": {
            "type": "object",
            "description": "Template variables, e.g. { amountMinor, currency }."
          }
        },
        "required": [
          "channel",
          "to",
          "template"
        ]
      }
    }
  }
}