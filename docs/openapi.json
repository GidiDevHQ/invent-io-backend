  "info": {
    "title": "Invent-IO API",
    "description": "Payment-triggered inventory backend",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Bar Soap"
          },
          "sku": {
            "type": "string",
            "example": "SOAP-001"
          },
          "barcode": {
            "type": "string",
            "example": "5901234123457"
          },
          "unit": {
            "type": "string",
            "example": "piece",
            "description": "Unit of sale, e.g. \"piece\", \"kg\""
          },
          "price": {
            "type": "number",
            "example": 150000,
            "description": "Price in integer minor units (e.g. kobo), in the org currency. Never a float."
          },
          "cost": {
            "type": "number",
            "example": 90000,
            "description": "Cost in integer minor units. Never a float."
          }
        },
        "required": [
          "name",
          "price",
          "cost"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Bar Soap"
          },
          "sku": {
            "type": "string",
            "example": "SOAP-001"
          },
          "barcode": {
            "type": "string",
            "example": "5901234123457"
          },
          "unit": {
            "type": "string",
            "example": "piece"
          },
          "price": {
            "type": "number",
            "example": 150000,
            "description": "Price in integer minor units. Never a float."
          },
          "cost": {
            "type": "number",
            "example": 90000,
            "description": "Cost in integer minor units. Never a float."
          },
          "active": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "AdjustStockDto": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "RESTOCK",
              "ADJUSTMENT",
              "RETURN"
            ]
          },
          "qtyDelta": {
            "type": "number",
            "example": 10,
            "description": "Signed change in units (negative to decrease)."
          },
          "reason": {
            "type": "string",
            "example": "Received supplier delivery",
            "description": "Required reason for the adjustment."
          }
        },
        "required": [
          "branchId",
          "productId",
          "type",
          "qtyDelta",
          "reason"
        ]
      },
      "SetThresholdDto": {
        "type": "object",
        "properties": {
          "lowStockThreshold": {
            "type": "number",
            "example": 5,
            "description": "Alert when stock is at or below this (0 disables)."
          }
        },
        "required": [
          "lowStockThreshold"
        ]
      }
    }
  }
}