# Copy to .env and fill in values. The app validates required vars at startup
# (see src/config/env.ts) and refuses to boot if any are missing.
# Never commit real secrets.

# --- Currently required by the app ---
DATABASE_URL=            # PostgreSQL connection, e.g. postgresql://user:pass@localhost:5432/inventio?schema=public
JWT_SECRET=              # Access-token signing secret
REDIS_URL=               # Queue backend for the outbox worker, e.g. redis://localhost:6379
PORT=                    # HTTP port (default 3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173 # Comma-separated allowed origins for browser requests
POSTGRES_PORT=           # Host port for the Postgres container (default 5432; change if taken)
REDIS_PORT=              # Host port for the Redis container (default 6379; change if taken)
WEBHOOK_WORKER_ENABLED=false # Set true in the API process to start webhook event processing
CREDENTIALS_ENCRYPTION_KEY= # Base64-encoded 32-byte AES-256-GCM key; required for payment secrets
PUBLIC_BASE_URL=         # Public app URL for links in account emails (default http://localhost:3000)

# --- Notifications channels (optional; a channel without its config errors at send) ---
WHATSAPP_TOKEN=          # Meta WhatsApp Cloud API access token (test number is fine)
WHATSAPP_PHONE_ID=       # Meta WhatsApp Cloud API phone number ID
WHATSAPP_API_VERSION=    # Graph API version (default v26.0)
EMAIL_API_KEY=           # Brevo transactional email API key
EMAIL_FROM=              # Fallback sender email, e.g. no-reply@yourdomain
EMAIL_FROM_NAME=         # Sender display name (default Invent-IO)
# Per-type sender addresses (the email's type picks which one). Set EMAIL_FROM_DOMAIN
# to auto-build noreply@/hello@/billing@/support@<domain>, or override each explicitly.
EMAIL_FROM_DOMAIN=       # e.g. invent-io.example
EMAIL_FROM_NOREPLY=      # security/transactional (verification, reset, OTP, alerts)
EMAIL_FROM_HELLO=        # onboarding/people (welcome, invites, weekly summary)
EMAIL_FROM_BILLING=      # money (payments, refunds, settlements)
EMAIL_FROM_SUPPORT=      # support correspondence
# Web Push (ADR 010); generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=        # VAPID public key (also served to the browser to subscribe)
VAPID_PRIVATE_KEY=       # VAPID private key (secret)
VAPID_SUBJECT=           # mailto: or https: contact URL (default mailto:no-reply@invent-io.example)

# --- Planned (technical spec §21.3); add as the corresponding modules land ---
JWT_ACCESS_SECRET=     # Spec splits token signing into access/refresh secrets
JWT_REFRESH_SECRET=
PUBLIC_BASE_URL=      # Public application URL used by external integrations
# --- Optional: Flow B sandbox provisioning proof (test keys only) ---
PAYSTACK_TEST_SECRET_KEY=sk_test_...
PAYSTACK_PLATFORM_TEST_SECRET_KEY=sk_test_... # Webhook signature verification
FLOW_B_BUSINESS_NAME=
FLOW_B_SETTLEMENT_BANK=   # Paystack bank code
FLOW_B_SETTLEMENT_ACCOUNT_NUMBER=
FLOW_B_OWNER_EMAIL=
FLOW_B_OWNER_NAME=
FLOW_B_OWNER_PHONE=
FLOW_B_CUSTOMER_FIRST_NAME=
FLOW_B_CUSTOMER_LAST_NAME=
FLOW_B_PREFERRED_BANK=    # Optional Paystack DVA bank slug
FCM_SERVICE_ACCOUNT=   # Push notifications
SMS_API_KEY=
SALE_VARIANCE_TOLERANCE=
SENTRY_DSN=
